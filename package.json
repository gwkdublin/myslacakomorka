{
  "name": "wykresy-powerpoint",
  "version": "0.2.0",
  "private": true,
  "description": "Dodatek do PowerPointa do szybkiego tworzenia zaawansowanych wykresów (inspirowany think-cell).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "certs": "office-addin-dev-certs install",
    "start": "office-addin-debugging start manifest.xml desktop --app powerpoint",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "dev-server": "vite"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.614",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "config": {
    "dev_server_port": 3000
  }
}
